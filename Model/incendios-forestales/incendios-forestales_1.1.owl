        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:unit</AbbreviatedIRI>
        <Literal xml:lang="en">A reference to the unit of measure of a quantity (variable or constant) of interest.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:unit</AbbreviatedIRI>
        <Literal xml:lang="es">Referencia a la unidad de medida de una cantidad (variable o constante) de interés.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>qudt:unit</AbbreviatedIRI>
