        <AbbreviatedIRI>geosparql:Feature</AbbreviatedIRI>
        <Literal xml:lang="es">Esta clase representa el tipo de característica de nivel superior. Esta clase es equivalente a GFI_Feature, definida en la norma ISO 19156:2011, y es la superclase de todos los tipos de características.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>geosparql:Feature</AbbreviatedIRI>
        <Literal xml:lang="en">This class represents the top-level feature type. This class is equivalent to GFI_Feature defined in ISO 19156:2011, and it is superclass of all feature types.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
