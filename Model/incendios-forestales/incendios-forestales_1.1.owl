    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <Literal xml:lang="en">An RDF/OWL vocabulary to represent spatial information on forest fires in Spain and Portugal within the european Cross-Forest project (INEA/CEF/ICT/A2017/156673).</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <Literal xml:lang="es">Un vocabulario RDF/OWL para representar información espacial sobre incendios forestales de España y Portugal en el seno del proyecto europeo Cross-Forest (INEA/CEF/ICT/A2017/156673).</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:title"/>
        <Literal xml:lang="en">Forest fire ontology of the Cross-Forest project.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:title"/>
        <Literal xml:lang="es">Ontología de incendios forestales del proyecto Cross-Forest.</Literal>
    </Annotation>
