        <IRI>http://qudt.org/2.1/schema/qudt</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:hasQuantity</AbbreviatedIRI>
        <Literal>has quantity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:hasQuantity</AbbreviatedIRI>
        <Literal xml:lang="es">tiene una cantidad</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>qudt:numericValue</AbbreviatedIRI>
        <IRI>http://qudt.org/2.1/schema/qudt</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:numericValue</AbbreviatedIRI>
        <Literal>numeric value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:numericValue</AbbreviatedIRI>
        <Literal xml:lang="es">valor númerico</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:ucumCode</AbbreviatedIRI>
        <Literal xml:lang="es">ucumCode asocia una unidad QUDT con su código UCUM (distingue entre mayúsculas y minúsculas).

En SHACL los valores se derivan de las propiedades ucum específicas utilizando &apos;sh:values&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:ucumCode</AbbreviatedIRI>
        <Literal xml:lang="en">ucumCode associates a QUDT unit with its UCUM code (case-sensitive).

In SHACL the values are derived from specifi ucum properties using &apos;sh:values&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:ucumCode</AbbreviatedIRI>
        <Literal xml:lang="es">código ucum</Literal>
    </AnnotationAssertion>
