    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>geosparql:wktLiteral</AbbreviatedIRI>
        <Literal xml:lang="en">A Well-known Text serialization of a geometry object.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
