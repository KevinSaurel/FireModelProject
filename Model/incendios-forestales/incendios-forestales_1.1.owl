    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>esadm:Provincia</AbbreviatedIRI>
        <Literal xml:lang="es">Cada una de las grandes divisiones de un territorio o Estado, sujeta por lo común a una autoridad administrativa [fuente: Diccionario de la lengua española (DRAE) 2011]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>esadm:Provincia</AbbreviatedIRI>
        <IRI>http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio</IRI>
