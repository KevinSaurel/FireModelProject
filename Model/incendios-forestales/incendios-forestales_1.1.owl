        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>esadm:codigoINE</AbbreviatedIRI>
        <Literal xml:lang="es">Código de la entidad territorial del INE. Por ejemplo, para municipios este código es de tres dígitos y está definido en http://www.ine.es/daco/daco42/codmun/codmun09/09codmun.xls</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
