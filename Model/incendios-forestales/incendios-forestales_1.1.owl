    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>dbo:District</AbbreviatedIRI>
        <Literal xml:lang="es">Distrito</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dbo:GovernmentalAdministrativeRegion</AbbreviatedIRI>
        <Literal xml:lang="en">An administrative body governing some territorial unity, in this case a governmental administrative body</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dbo:GovernmentalAdministrativeRegion</AbbreviatedIRI>
        <Literal xml:lang="es">Órgano administrativo que rige alguna unidad territorial, en este caso un órgano administrativo gubernamental</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>dbo:Municipality</AbbreviatedIRI>
        <Literal xml:lang="en">Municipality</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>dbo:Municipality</AbbreviatedIRI>
        <Literal xml:lang="es">Municipio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <IRI>http://inspire.ec.europa.eu/codelist/NaturalHazardCategoryValue/forestFireWildfire</IRI>
        <Literal xml:lang="en">Forest fire means fire which breaks out and spreads on forest and other wooded land or which breaks out on other land and spreads to forest and other wooded land. The definition of forest fire excludes prescribed or controlled burning, usually with the aim of reducing or eliminating the quantity of accumulated fuel on the ground (Regulation EC 2152/2003 - Forest Focus). Wildland Fire: Any fire occurring on wildland regardless of ignition sources, damages or benefits (FAO, 2011, Wildland Fire Management Terminology, FAO, updated September 2010).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://inspire.ec.europa.eu/codelist/NaturalHazardCategoryValue/forestFireWildfire</IRI>
        <Literal xml:lang="en">forest fires or wild fires</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <IRI>http://inspire.ec.europa.eu/glossary/SpatialReferenceSystem</IRI>
        <Literal xml:lang="en">System for identifying position in the real world [ISO 19112]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dct:title"/>
        <IRI>http://inspire.ec.europa.eu/glossary/SpatialReferenceSystem</IRI>
        <Literal xml:lang="en">Spatial reference system</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="owl2:sameAs"/>
        <IRI>http://inspire.ec.europa.eu/glossary/SpatialReferenceSystem</IRI>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">http://inspire.ec.europa.eu/glossary/SpatialReferenceSystem:2&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>event:Event</AbbreviatedIRI>
        <Literal xml:lang="en">An arbitrary classification of a space/time region, by a cognitive agent. An event may have actively participating agents, passive factors, products, and a location in space/time.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>event:Event</AbbreviatedIRI>
        <Literal xml:lang="es">Una clasificación arbitraria de una región del espacio/tiempo, por parte de un agente cognitivo. Un evento puede tener agentes que participan activamente, factores pasivos, productos y una ubicación en el espacio/tiempo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>event:Event</AbbreviatedIRI>
        <Literal>Event</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:Agent</AbbreviatedIRI>
        <Literal xml:lang="en">A resource that acts or has the power to act.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:Agent</AbbreviatedIRI>
        <Literal xml:lang="es">Un recurso que actúa o tiene el poder de actuar.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:LicenseDocument</AbbreviatedIRI>
        <Literal xml:lang="en">A legal document giving official permission to do something with a resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:LicenseDocument</AbbreviatedIRI>
        <Literal xml:lang="es">Un documento legal que da permiso oficial para hacer algo con un recurso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:LinguisticSystem</AbbreviatedIRI>
        <Literal xml:lang="en">A system of signs, symbols, sounds, gestures, or rules used in communication.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:LinguisticSystem</AbbreviatedIRI>
        <Literal xml:lang="es">Sistema de signos, símbolos, sonidos, gestos o reglas utilizados en la comunicación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:Location</AbbreviatedIRI>
        <Literal xml:lang="en">A spatial region or named place.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:Location</AbbreviatedIRI>
        <Literal xml:lang="es">Una región espacial o un lugar con nombre.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:PeriodOfTime</AbbreviatedIRI>
        <Literal xml:lang="en">An interval of time that is named or defined by its start and end dates.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:PeriodOfTime</AbbreviatedIRI>
        <Literal xml:lang="es">Un intervalo de tiempo que se nombra o define por sus fechas de inicio y fin.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:ProvenanceStatement</AbbreviatedIRI>
        <Literal xml:lang="en">A statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:ProvenanceStatement</AbbreviatedIRI>
        <Literal xml:lang="es">Una declaración de cualquier cambio en la propiedad y custodia de un recurso desde su creación que sea significativo para su autenticidad, integridad e interpretación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:RightsStatement</AbbreviatedIRI>
        <Literal xml:lang="en">A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:RightsStatement</AbbreviatedIRI>
        <Literal xml:lang="es">Una declaración sobre los derechos de propiedad intelectual (DPI) que se tienen sobre un recurso, un documento legal que da permiso oficial para hacer algo con un recurso o una declaración sobre los derechos de acceso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:Standard</AbbreviatedIRI>
        <Literal xml:lang="en">A reference point against which other things can be evaluated or compared.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:Standard</AbbreviatedIRI>
        <Literal xml:lang="es">Un punto de referencia con el que se pueden evaluar o comparar otras cosas.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:conformsTo</AbbreviatedIRI>
        <Literal xml:lang="en">An established standard to which the described resource conforms.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:conformsTo</AbbreviatedIRI>
        <Literal xml:lang="es">Norma establecida a la que se ajusta el recurso descrito.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:identifier</AbbreviatedIRI>
        <Literal xml:lang="en">An unambiguous reference to the resource within a given context.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:identifier</AbbreviatedIRI>
        <Literal xml:lang="es">Una referencia inequívoca al recurso dentro de un contexto determinado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>dct:identifier</AbbreviatedIRI>
        <Literal xml:lang="es">identificador</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>dct:identifier</AbbreviatedIRI>
        <Literal xml:lang="en">identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:language</AbbreviatedIRI>
        <Literal xml:lang="es">Un lenguaje del recurso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:license</AbbreviatedIRI>
        <Literal xml:lang="en">A legal document under which the resource is made available.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:license</AbbreviatedIRI>
        <Literal xml:lang="es">Documento legal en virtud del cual se pone a disposición el recurso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:provenance</AbbreviatedIRI>
        <Literal xml:lang="en">A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:provenance</AbbreviatedIRI>
        <Literal xml:lang="es">Una declaración de cualquier cambio en la propiedad y custodia del recurso desde su creación que sea significativo para su autenticidad, integridad e interpretación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:publisher</AbbreviatedIRI>
        <Literal xml:lang="es">Algunos ejemplos de editor son una persona, una organización o un servicio. Normalmente, el nombre de un editor debe utilizarse para indicar la entidad.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:publisher</AbbreviatedIRI>
        <Literal xml:lang="en">Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:rights</AbbreviatedIRI>
        <Literal xml:lang="en">A statement that concerns all rights not addressed with dct:license or dcterms:accessRights, such as copyright statements.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:rights</AbbreviatedIRI>
        <Literal xml:lang="es">Una declaración que se refiere a todos los derechos no abordados con dct:license o dcterms:accessRights, como las declaraciones de derechos de autor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:spatial</AbbreviatedIRI>
        <Literal xml:lang="es">Características espaciales del recurso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:spatial</AbbreviatedIRI>
        <Literal>Spatial characteristics of the resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:temporal</AbbreviatedIRI>
        <Literal xml:lang="es">Características temporales del recurso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:temporal</AbbreviatedIRI>
        <Literal>Temporal characteristics of the resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:type</AbbreviatedIRI>
        <Literal xml:lang="es">La naturaleza o el género del recurso.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dct:type</AbbreviatedIRI>
        <Literal>The nature or genre of the resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>uneskos:contains</AbbreviatedIRI>
        <Literal xml:lang="es">El modelo SKOS define la propiedad skos:inScheme como un mecanismo para vincular un Concepto con uno o varios Esquemas Conceptuales. Sin embargo, SKOS no incluye una propiedad inversa que permita definir los elementos que contiene un esquema conceptual.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>uneskos:contains</AbbreviatedIRI>
        <Literal xml:lang="en">The SKOS model define the skos:inScheme property as a mechanism to link a Concept with one or serveral Concept Schemes. However, SKOS does not include an inverse property that allows to define the elements that are contained by a Concept Scheme.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>uneskos:contains</AbbreviatedIRI>
        <IRI>https://skos.um.es/TR/uneskos/#contains</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:Quantity</AbbreviatedIRI>
        <Literal xml:lang="es">Cantidad</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:Quantity</AbbreviatedIRI>
        <Literal xml:lang="en">Quantity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:QuantityValue</AbbreviatedIRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">A &lt;i&gt;Quantity Value&lt;/i&gt; expresses the magnitude and kind of a quantity and is given by the product of a numerical value &lt;code&gt;n&lt;/code&gt; and a unit of measure &lt;code&gt;U&lt;/code&gt;. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to &lt;a href=\&quot;http://physics.nist.gov/Pubs/SP811/sec07.html\&quot;&gt;NIST SP 811 section 7&lt;/a&gt; for more on quantity values.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>qudt:QuantityValue</AbbreviatedIRI>
        <IRI>http://qudt.org/2.1/schema/qudt</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:QuantityValue</AbbreviatedIRI>
        <Literal xml:lang="en">Quantity value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:QuantityValue</AbbreviatedIRI>
        <Literal xml:lang="es">Valor de la cantidad</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:Unit</AbbreviatedIRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). Any measurement of the length can be expressed as a number multiplied by the unit meter. More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  \\(Q = nU\\).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>qudt:Unit</AbbreviatedIRI>
        <IRI>http://qudt.org/2.1/schema/qudt</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:Unit</AbbreviatedIRI>
        <Literal xml:lang="es">Unidad</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:Unit</AbbreviatedIRI>
        <Literal xml:lang="en">Unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:code</AbbreviatedIRI>
        <Literal xml:lang="en">A code is a string that uniquely identifies a QUDT concept. The code is constructed from the designator. The use of this property has been deprecated</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>qudt:code</AbbreviatedIRI>
        <Literal xml:lang="es">Un código es una cadena que identifica de forma exclusiva un concepto QUDT. El código se construye a partir del designador. El uso de esta propiedad ha quedado obsoleto</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:code</AbbreviatedIRI>
        <Literal xml:lang="en">code</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>qudt:code</AbbreviatedIRI>
        <Literal xml:lang="es">código</Literal>
    </AnnotationAssertion>
